# Ignore local dependencies and logs
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# CRITICAL: Never copy host bind-mounted APK uploads or runtime database into Docker build context!
# Keeping ./uploads and ./data out of the build context ensures `docker compose build`
# takes <2 seconds even when you have gigabytes of Kodi/Jellyfin APKs in ./uploads.
data
uploads
android
.env*

# Git & editor files
.git
.gitignore
.DS_Store
*.swp
*.bak
