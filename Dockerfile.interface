FROM node:20-alpine

LABEL maintainer="KV-TV Store <admin@tv.vndns.net>"
LABEL description="KV-TV Storefront Interface & Reverse Proxy (https://tv.vndns.net)"

WORKDIR /app

COPY package.json ./
COPY interface-server.js ./
COPY public ./public

# Remove admin console assets from public storefront image (proxied to kv-tv-backend)
# and ensure /app is owned by non-root node:node user
RUN rm -f /app/public/admin.html /app/public/admin.js /app/public/admin.css \
 && chown -R node:node /app

ENV NODE_ENV=production
ENV PORT=3456
ENV BACKEND_URL=http://kv-tv-backend:3457
ENV TZ=Asia/Ho_Chi_Minh

USER node

EXPOSE 3456

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3456/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "interface-server.js"]
