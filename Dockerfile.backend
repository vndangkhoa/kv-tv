FROM node:20-alpine

LABEL maintainer="KV-TV Store <admin@tv.vndns.net>"
LABEL description="KV-TV Backend API, Admin Portal & APK Distribution Engine (https://tv.vndns.net)"

WORKDIR /app

# Install production dependencies
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

# Copy backend source, libraries, Kodi addon bundle, and admin/fallback static assets
COPY server.js ./
COPY lib ./lib
COPY addons ./addons
COPY public ./public

# Create persistent directories for bind mounts and set node:node ownership
# /app/data    -> store.json (catalog, analytics, 2FA secret, ads)
# /app/uploads -> .apk binaries and .zip pre-set configuration packs
RUN mkdir -p /app/data /app/uploads && chown -R node:node /app

ENV NODE_ENV=production
ENV PORT=3457
ENV PUBLIC_BASE_URL=https://tv.vndns.net
ENV TZ=Asia/Ho_Chi_Minh

VOLUME ["/app/data", "/app/uploads"]

EXPOSE 3457

HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3457/api/catalog?track=0').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
