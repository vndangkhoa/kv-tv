{
  "name": "kv-tv-store",
  "version": "1.0.0",
  "description": "KV-TV Android TV App Store, Pre-Set Media APK Distribution & Admin Portal (https://tv.vndns.net)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:backend": "PORT=3457 node server.js",
    "start:interface": "PORT=3456 node interface-server.js",
    "dev": "node --watch server.js",
    "2fa": "bash scripts/get-2fa.sh",
    "seed": "node -e \"require('./lib/seed').ensureSeeded(true)\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
